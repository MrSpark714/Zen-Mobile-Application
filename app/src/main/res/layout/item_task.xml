<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_3sdp"
    android:layout_marginBottom="@dimen/_3sdp"
    app:cardBackgroundColor="@color/zen_surface"
    app:cardCornerRadius="@dimen/_13sdp"
    app:cardElevation="0dp"
    app:strokeColor="@color/zen_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_11sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_11sdp"
        android:paddingBottom="@dimen/_10sdp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_task_status"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:buttonTint="@color/zen_accent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_7sdp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_task"
            app:layout_constraintStart_toEndOf="@id/cb_task_status"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_task_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="Morning deep work session" />

            <!-- Time Window & Duration Indicator -->
            <LinearLayout
                android:id="@+id/layout_task_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@drawable/bg_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_7sdp"
                android:paddingTop="@dimen/_2sdp"
                android:paddingEnd="@dimen/_7sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_time_icon"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:contentDescription="Time"
                    android:src="@drawable/ic_schedule"
                    app:tint="@color/zen_accent" />

                <TextView
                    android:id="@+id/tv_task_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="monospace"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="@dimen/_9ssp"
                    tools:text="9:00 AM → 12:00 PM (In 3 hrs)" />
            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_delete_task"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:padding="@dimen/_5sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/zen_text_tertiary" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
