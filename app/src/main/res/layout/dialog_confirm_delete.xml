<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_20sdp"
    app:cardBackgroundColor="@color/zen_surface"
    app:cardCornerRadius="@dimen/_20sdp"
    app:cardElevation="@dimen/_10sdp"
    app:strokeColor="@color/zen_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingTop="@dimen/_23sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:paddingBottom="@dimen/_20sdp">

        <!-- Danger Icon Badge -->
        <FrameLayout
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_46sdp"
            android:background="@drawable/bg_status_absent">

            <ImageView
                android:id="@+id/iv_delete_icon"
                android:layout_width="@dimen/_23sdp"
                android:layout_height="@dimen/_23sdp"
                android:layout_gravity="center"
                android:contentDescription="Delete Icon"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_absent" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_delete_popup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_13sdp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.05"
            android:text="DELETE ITEM"
            android:textColor="@color/zen_text_primary"
            android:textSize="@dimen/_15ssp" />

        <!-- Description Message -->
        <TextView
            android:id="@+id/tv_delete_popup_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_2sdp"
            android:text="Are you sure you want to delete this item? This action cannot be undone."
            android:textColor="@color/zen_text_secondary"
            android:textSize="@dimen/_12ssp" />

        <!-- Target Item Highlight Box (Optional preview) -->
        <TextView
            android:id="@+id/tv_delete_item_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp"
            android:background="@drawable/bg_card_task"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="@dimen/_11sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_11sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:textColor="@color/zen_text_primary"
            android:textSize="@dimen/_11ssp"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_delete_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:minHeight="@dimen/_38sdp"
                android:text="@string/cancel"
                android:textColor="@color/zen_text_secondary"
                app:cornerRadius="@dimen/_10sdp"
                app:strokeColor="@color/zen_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_delete_confirm"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/status_absent"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:minHeight="@dimen/_38sdp"
                android:text="@string/delete"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/_10sdp"
                app:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
