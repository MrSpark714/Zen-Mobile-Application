<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/card_delete_modal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_delete_modal_card"
        android:elevation="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="348dp">

        <!-- Destructive Icon Badge with Top-Right Red Dot -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_delete_icon_badge">

                <ImageView
                    android:id="@+id/iv_delete_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="Delete warning icon"
                    android:src="@drawable/ic_delete_forever"
                    app:tint="@color/zen_danger" />
            </FrameLayout>

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_delete_badge_dot" />
        </FrameLayout>

        <!-- Modal Title -->
        <TextView
            android:id="@+id/tv_delete_popup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:textColor="@color/zen_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Delete Note?" />

        <!-- Contextual Description -->
        <TextView
            android:id="@+id/tv_delete_popup_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/zen_text_secondary"
            android:textSize="13.5sp"
            tools:text="This note will be permanently removed from your local ZEN vault. This action cannot be undone." />

        <!-- Target Item Preview Card -->
        <LinearLayout
            android:id="@+id/layout_delete_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_delete_preview_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_dot_preview_danger" />

                <TextView
                    android:id="@+id/tv_delete_item_preview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/zen_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="App Feature Improvements" />

                <TextView
                    android:id="@+id/tv_delete_preview_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_preview_lime"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/zen_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="★ Important"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_delete_preview_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="9dp"
                    android:background="@color/zen_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_delete_preview_meta_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="11sp"
                        tools:text="3 checklist items" />

                    <TextView
                        android:id="@+id/tv_delete_preview_meta_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="11sp"
                        tools:text="Oct 14, 2026" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Ergonomic Pill Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_delete_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/zen_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/zen_surface_variant"
                app:cornerRadius="100dp"
                app:elevation="0dp"
                app:strokeColor="@color/zen_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_delete_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/zen_danger"
                app:cornerRadius="100dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
