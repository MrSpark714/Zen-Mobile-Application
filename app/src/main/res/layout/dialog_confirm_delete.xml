<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/zen_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/zen_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="23dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Danger Icon Badge -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_status_absent">

            <ImageView
                android:id="@+id/iv_delete_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:contentDescription="Delete Icon"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_absent" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_delete_popup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.05"
            android:text="DELETE ITEM"
            android:textColor="@color/zen_text_primary"
            android:textSize="15sp" />

        <!-- Description Message -->
        <TextView
            android:id="@+id/tv_delete_popup_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Are you sure you want to delete this item? This action cannot be undone."
            android:textColor="@color/zen_text_secondary"
            android:textSize="12sp" />

        <!-- Target Item Highlight Box (Optional preview) -->
        <TextView
            android:id="@+id/tv_delete_item_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_card_task"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="11dp"
            android:paddingTop="8dp"
            android:paddingEnd="11dp"
            android:paddingBottom="8dp"
            android:textColor="@color/zen_text_primary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_delete_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:minHeight="38dp"
                android:text="@string/cancel"
                android:textColor="@color/zen_text_secondary"
                app:cornerRadius="10dp"
                app:strokeColor="@color/zen_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_delete_confirm"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:backgroundTint="@color/status_absent"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:minHeight="38dp"
                android:text="@string/delete"
                android:textColor="@color/white"
                app:cornerRadius="10dp"
                app:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
