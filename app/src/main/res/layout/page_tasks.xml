<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_7sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_80sdp"
        tools:listitem="@layout/item_task" />

    <!-- Empty State for Tasks -->
    <LinearLayout
        android:id="@+id/layout_empty_tasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_26sdp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_46sdp"
            android:contentDescription="Empty Tasks"
            android:src="@drawable/ic_tasks"
            android:tint="@color/zen_surface_highlight" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_13sdp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/empty_tasks_title"
            android:textColor="@color/zen_text_primary"
            android:textSize="@dimen/_15ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/empty_tasks_desc"
            android:textColor="@color/zen_text_secondary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>
</FrameLayout>
