<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/zen_text_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/btn_back"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="SETTINGS &amp; DATA"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.03"
                        android:text="Theme Accent &amp; Offline Sync"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Loading / Progress Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/zen_accent"
                app:trackColor="@color/zen_surface_highlight" />

            <!-- SECTION 1: ACCENT THEME COLOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="ACCENT THEME COLOR"
                android:textColor="@color/zen_text_secondary"
                android:textSize="11.5sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_theme_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/zen_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/zen_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Horizontal Selector for 5 Theme Colors -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp">

                        <!-- Color 1: #a7ff67 (Mint Green) -->
                        <FrameLayout
                            android:id="@+id/frame_color_mint"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/ring_color_mint"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:backgroundTint="#a7ff67" />

                            <ImageView
                                android:id="@+id/check_color_mint"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Mint Selected"
                                android:src="@drawable/ic_check"
                                android:visibility="visible"
                                app:tint="#121212" />
                        </FrameLayout>

                        <!-- Color 2: #00f6ac (Neon Teal) -->
                        <FrameLayout
                            android:id="@+id/frame_color_teal"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/ring_color_teal"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:visibility="gone" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:backgroundTint="#00f6ac" />

                            <ImageView
                                android:id="@+id/check_color_teal"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Teal Selected"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="#121212" />
                        </FrameLayout>

                        <!-- Color 3: #07B7DC (Cyan Blue) -->
                        <FrameLayout
                            android:id="@+id/frame_color_cyan"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/ring_color_cyan"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:visibility="gone" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:backgroundTint="#07B7DC" />

                            <ImageView
                                android:id="@+id/check_color_cyan"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Cyan Selected"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="#121212" />
                        </FrameLayout>

                        <!-- Color 4: #BDD0B8 (Sage Green) -->
                        <FrameLayout
                            android:id="@+id/frame_color_sage"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/ring_color_sage"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:visibility="gone" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:backgroundTint="#BDD0B8" />

                            <ImageView
                                android:id="@+id/check_color_sage"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Sage Selected"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="#121212" />
                        </FrameLayout>

                        <!-- Color 5: #D0FF00 (Electric Lime) -->
                        <FrameLayout
                            android:id="@+id/frame_color_lime"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/ring_color_lime"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:visibility="gone" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_item"
                                android:backgroundTint="#D0FF00" />

                            <ImageView
                                android:id="@+id/check_color_lime"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Lime Selected"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                app:tint="#121212" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_theme_applied_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Tap any color chip to instantly theme tabs, badges &amp; buttons"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: DATABASE & BACKUP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="CURRENT LOCAL DATABASE"
                android:textColor="@color/zen_text_secondary"
                android:textSize="11.5sp" />

            <!-- Database Summary Stats Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/zen_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/zen_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_db_stats_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.12"
                        android:text="LOCAL STORAGE SUMMARY"
                        android:textAllCaps="true"
                        android:textColor="@color/zen_accent"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_count_notes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="0"
                                android:textColor="@color/zen_text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Notes"
                                android:textColor="@color/zen_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_count_tasks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="0"
                                android:textColor="@color/zen_text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Tasks"
                                android:textColor="@color/zen_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_count_classes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="0"
                                android:textColor="@color/zen_text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Classes"
                                android:textColor="@color/zen_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_count_attendance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="0"
                                android:textColor="@color/zen_text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Logs"
                                android:textColor="@color/zen_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup Scope & Options Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="BACKUP SCOPE"
                android:textColor="@color/zen_text_secondary"
                android:textSize="11.5sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/zen_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/zen_border"
                app:strokeWidth="1dp">

                <RadioGroup
                    android:id="@+id/rg_backup_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <!-- Option 1: Full Backup -->
                    <RadioButton
                        android:id="@+id/rb_full_backup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/zen_accent"
                        android:checked="true"
                        android:fontFamily="sans-serif-medium"
                        android:padding="6dp"
                        android:text="Full Backup"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="38dp"
                        android:layout_marginTop="-2dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif"
                        android:text="Includes Notes, Tasks, Class Timetable &amp; Attendance Records"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="11.5sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="38dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/zen_divider" />

                    <!-- Option 2: Notes & Attendance -->
                    <RadioButton
                        android:id="@+id/rb_notes_attendance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/zen_accent"
                        android:fontFamily="sans-serif-medium"
                        android:padding="6dp"
                        android:text="Notes &amp; Attendance"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="38dp"
                        android:layout_marginTop="-2dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif"
                        android:text="Includes Notes, Class Timetable &amp; Attendance Records (Excludes Tasks)"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="11.5sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="38dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/zen_divider" />

                    <!-- Option 3: Attendance Only -->
                    <RadioButton
                        android:id="@+id/rb_attendance_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/zen_accent"
                        android:fontFamily="sans-serif-medium"
                        android:padding="6dp"
                        android:text="Attendance Only"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="38dp"
                        android:layout_marginTop="-2dp"
                        android:fontFamily="sans-serif"
                        android:text="Includes Class Timetable &amp; Attendance History only"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="11.5sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Export and Import Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_backup"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/zen_accent"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.05"
                    android:text="Export Backup"
                    android:textColor="@color/zen_on_accent"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_upload"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/zen_on_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_backup"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/zen_surface"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.05"
                    android:text="Import Backup"
                    android:textColor="@color/zen_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/zen_text_primary"
                    app:strokeColor="@color/zen_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Highlighted Cohort Sharing Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="COHORT SHARING"
                android:textColor="@color/zen_text_secondary"
                android:textSize="11.5sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cohort_sharing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/zen_accent_container"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/zen_accent"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_cohort_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Cohort Sharing"
                            android:src="@drawable/ic_groups"
                            app:tint="@color/zen_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:text="Share Class Timetable"
                            android:textColor="@color/zen_text_primary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:text="Export your weekly schedule as a portable JSON package and share directly via WhatsApp, Telegram, or Email with classmates. Classmates can tap the file to instantly load the timetable."
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_timetable"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/zen_accent"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.06"
                        android:text="Share Class Timetable"
                        android:textColor="@color/zen_on_accent"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/zen_on_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status / Information Note -->
            <TextView
                android:id="@+id/tv_status_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="ZEN is 100% offline-first. Your data is stored strictly on your local device and never transmitted to external cloud servers without your explicit action."
                android:textColor="@color/zen_text_tertiary"
                android:textSize="11.5sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
