<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header & Sub-Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_attendance_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="ZEN ATTENDANCE"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_date_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/zen_accent"
                    android:textSize="12sp"
                    tools:text="Wednesday" />
            </RelativeLayout>

            <!-- Sub-Navigation Segmented Control (TODAY / SCHEDULE / HISTORY) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_floating_bottom_nav"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tab_today"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_tab_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="TODAY"
                    android:textColor="@color/zen_on_accent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tab_timetable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="SCHEDULE"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tab_analytics"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="HISTORY"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTAINER FOR SUB-VIEWS -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1. TODAY'S CLASSES VIEW -->
            <LinearLayout
                android:id="@+id/view_today_classes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Header Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tv_today_summary_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="13sp"
                        tools:text="Showing classes scheduled for today" />
                </LinearLayout>

                <!-- RecyclerView for Today's Classes -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_today_classes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="76dp" />

                <!-- Empty State for Today / Weekend -->
                <LinearLayout
                    android:id="@+id/layout_empty_today"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌸"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tv_empty_today_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="No classes this weekend"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_empty_today_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Enjoy your rest and mindfulness. Weekends are free of scheduled classes."
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. WEEKLY CONFIGURATION / SCHEDULE VIEW -->
            <LinearLayout
                android:id="@+id/view_weekly_schedule"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Mon-Fri Filter Pills (Strictly weekdays only) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:overScrollMode="never"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="3dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/filter_day_all"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="All Days"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/filter_day_mon"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Monday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/filter_day_tue"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Tuesday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/filter_day_wed"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Wednesday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/filter_day_thu"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Thursday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/filter_day_fri"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Friday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- RecyclerView for Weekly Schedule -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_weekly_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="76dp" />

                <!-- Empty State for Schedule -->
                <LinearLayout
                    android:id="@+id/layout_empty_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗓️"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tv_empty_schedule_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="No classes scheduled"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_empty_schedule_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Tap the '+' button below to configure repeating classes for Monday through Friday."
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. HISTORY & SUBJECT LEDGER VIEW -->
            <LinearLayout
                android:id="@+id/view_analytics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Subject Breakdown List -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:text="ENROLLED SUBJECTS"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_subject_analytics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="76dp" />

                <!-- Empty State for Analytics -->
                <LinearLayout
                    android:id="@+id/layout_empty_analytics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tv_empty_analytics_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="No analytics available"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_empty_analytics_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Configure your class schedule and mark attendance to see detailed subject statistics."
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- Floating Action Button to Add Class -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_class"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Schedule Class"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/zen_accent"
        app:elevation="4dp"
        app:fabCustomSize="52dp"
        app:maxImageSize="24dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/zen_on_accent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
