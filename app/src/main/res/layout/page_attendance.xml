<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header & Sub-Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_16sdp"
            android:paddingTop="@dimen/_13sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingBottom="@dimen/_7sdp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_attendance_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.05"
                    android:text="ZEN ATTENDANCE"
                    android:textColor="@color/zen_text_primary"
                    android:textSize="@dimen/_17ssp" />

                <TextView
                    android:id="@+id/tv_current_date_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/_7sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingEnd="@dimen/_7sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:textColor="@color/zen_accent"
                    android:textSize="@dimen/_10ssp"
                    tools:text="Wednesday" />
            </RelativeLayout>

            <!-- Sub-Navigation Segmented Control (TODAY / TIMETABLE / ANALYTICS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_11sdp"
                android:background="@drawable/bg_floating_bottom_nav"
                android:orientation="horizontal"
                android:padding="@dimen/_2sdp">

                <TextView
                    android:id="@+id/tab_today"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_tab_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:text="TODAY"
                    android:textColor="@color/zen_on_accent"
                    android:textSize="@dimen/_10ssp" />

                <TextView
                    android:id="@+id/tab_timetable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:text="SCHEDULE"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="@dimen/_10ssp" />

                <TextView
                    android:id="@+id/tab_analytics"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:text="HISTORY"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTAINER FOR SUB-VIEWS -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1. TODAY'S CLASSES VIEW -->
            <LinearLayout
                android:id="@+id/view_today_classes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Header Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_5sdp">

                    <TextView
                        android:id="@+id/tv_today_summary_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="@dimen/_10ssp"
                        tools:text="Showing classes scheduled for today" />
                </LinearLayout>

                <!-- RecyclerView for Today's Classes -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_today_classes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/_72sdp" />

                <!-- Empty State for Today / Weekend -->
                <LinearLayout
                    android:id="@+id/layout_empty_today"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_26sdp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌸"
                        android:textSize="@dimen/_30ssp" />

                    <TextView
                        android:id="@+id/tv_empty_today_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="No classes this weekend"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:id="@+id/tv_empty_today_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Enjoy your rest and mindfulness. Weekends are free of scheduled classes."
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. WEEKLY CONFIGURATION / SCHEDULE VIEW -->
            <LinearLayout
                android:id="@+id/view_weekly_schedule"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Mon-Fri Filter Pills (Strictly weekdays only) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingBottom="@dimen/_7sdp">

                        <TextView
                            android:id="@+id/filter_day_all"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_26sdp"
                            android:background="@drawable/bg_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="@dimen/_11sdp"
                            android:paddingEnd="@dimen/_11sdp"
                            android:text="All Days"
                            android:textColor="@color/zen_accent"
                            android:textSize="@dimen/_10ssp" />

                        <TextView
                            android:id="@+id/filter_day_mon"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="@dimen/_11sdp"
                            android:paddingEnd="@dimen/_11sdp"
                            android:text="Monday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="@dimen/_10ssp" />

                        <TextView
                            android:id="@+id/filter_day_tue"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="@dimen/_11sdp"
                            android:paddingEnd="@dimen/_11sdp"
                            android:text="Tuesday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="@dimen/_10ssp" />

                        <TextView
                            android:id="@+id/filter_day_wed"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="@dimen/_11sdp"
                            android:paddingEnd="@dimen/_11sdp"
                            android:text="Wednesday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="@dimen/_10ssp" />

                        <TextView
                            android:id="@+id/filter_day_thu"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="@dimen/_11sdp"
                            android:paddingEnd="@dimen/_11sdp"
                            android:text="Thursday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="@dimen/_10ssp" />

                        <TextView
                            android:id="@+id/filter_day_fri"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="@dimen/_11sdp"
                            android:paddingEnd="@dimen/_11sdp"
                            android:text="Friday"
                            android:textColor="@color/zen_text_secondary"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- RecyclerView for Weekly Schedule -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_weekly_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/_72sdp" />

                <!-- Empty State for Schedule -->
                <LinearLayout
                    android:id="@+id/layout_empty_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_26sdp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗓️"
                        android:textSize="@dimen/_30ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="No classes scheduled"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Tap the '+' button below to configure repeating classes for Monday through Friday."
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. HISTORY & SUBJECT LEDGER VIEW -->
            <LinearLayout
                android:id="@+id/view_analytics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Subject Breakdown List -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="ENROLLED SUBJECTS"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="@dimen/_10ssp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_subject_analytics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/_72sdp" />

                <!-- Empty State for Analytics -->
                <LinearLayout
                    android:id="@+id/layout_empty_analytics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_26sdp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊"
                        android:textSize="@dimen/_30ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="No analytics available"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Configure your class schedule and mark attendance to see detailed subject statistics."
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- Floating Action Button to Add Class -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_class"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:contentDescription="Schedule Class"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/zen_accent"
        app:elevation="@dimen/_3sdp"
        app:fabCustomSize="@dimen/_46sdp"
        app:maxImageSize="@dimen/_22sdp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/zen_on_accent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
