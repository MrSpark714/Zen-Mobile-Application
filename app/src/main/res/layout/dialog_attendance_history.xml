<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Pill -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/tv_dialog_history_percentage"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dialog_history_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:textColor="@color/zen_text_primary"
                android:textSize="17sp"
                tools:text="Operating Systems" />

            <TextView
                android:id="@+id/tv_dialog_history_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/zen_text_secondary"
                android:textSize="12sp"
                tools:text="14 Total Marked Sessions" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_dialog_history_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/zen_accent"
            android:textSize="15sp"
            tools:text="85.7%" />
    </RelativeLayout>

    <!-- Formula explanation note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_task"
        android:fontFamily="sans-serif"
        android:padding="10dp"
        android:text="Formula: (Present / (Present + Absent)) × 100\n* Holidays are excluded from percentage calculation."
        android:textColor="@color/zen_text_tertiary"
        android:textSize="11.5sp" />

    <!-- History RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dialog_history"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <!-- Empty State for History -->
    <TextView
        android:id="@+id/tv_empty_history"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No attendance records marked yet for this subject."
        android:textColor="@color/zen_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_history"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/zen_surface_variant"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:text="Close"
        android:textColor="@color/zen_text_primary"
        app:cornerRadius="12dp"
        app:strokeColor="@color/zen_border"
        app:strokeWidth="1dp" />

</LinearLayout>
