<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_15sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_23sdp">

    <!-- Bottom Sheet Drag Handle indicator -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_11sdp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/zen_surface_highlight" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.1"
        android:text="NEW TASK"
        android:textColor="@color/zen_text_primary"
        android:textSize="@dimen/_14ssp" />

    <!-- Task Description Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_task_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        app:boxBackgroundColor="@color/zen_surface_variant"
        app:boxCornerRadiusBottomEnd="@dimen/_11sdp"
        app:boxCornerRadiusBottomStart="@dimen/_11sdp"
        app:boxCornerRadiusTopEnd="@dimen/_11sdp"
        app:boxCornerRadiusTopStart="@dimen/_11sdp"
        app:boxStrokeColor="@color/zen_accent"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="@dimen/_2sdp"
        app:hintTextColor="@color/zen_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_task_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:hint="@string/add_task_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:textColor="@color/zen_text_primary"
            android:textColorHint="@color/zen_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Task Completion Time / Duration Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:text="COMPLETION TIME &amp; DURATION"
        android:textColor="@color/zen_text_secondary"
        android:textSize="@dimen/_9ssp" />

    <!-- Horizontal Scrollable Duration Presets -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_no_limit"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="No Limit"
                android:textColor="@color/zen_accent"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/chip_30m"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="30 Mins"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/chip_1h"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="1 Hour"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <!-- Specifically requested 3 Hours -->
            <TextView
                android:id="@+id/chip_3h"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="3 Hours"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/chip_today_eod"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="Today EOD (6 PM)"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/chip_custom_time"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="Custom Time ⏱️"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Timing Summary Card -->
    <LinearLayout
        android:id="@+id/layout_timing_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_card_task"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:contentDescription="Timer"
                android:src="@drawable/ic_schedule"
                app:tint="@color/zen_accent" />

            <TextView
                android:id="@+id/tv_timing_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_10ssp"
                tools:text="Start: 10:00 AM • Due: 1:00 PM (3 hrs)" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="sans-serif"
            android:text="🔔 Notification will pull to status bar when due"
            android:textColor="@color/zen_accent"
            android:textSize="@dimen/_9ssp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_task"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_35sdp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/cancel"
            android:textColor="@color/zen_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_task"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginStart="@dimen/_7sdp"
            android:backgroundTint="@color/zen_accent"
            android:fontFamily="sans-serif-medium"
            android:text="Add Task"
            android:textColor="@color/zen_on_accent"
            app:cornerRadius="@dimen/_11sdp" />
    </LinearLayout>

</LinearLayout>
