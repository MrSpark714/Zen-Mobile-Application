<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Bottom Sheet Drag Handle indicator -->
    <View
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/zen_surface_highlight" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08"
        android:text="NEW TASK"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Task Description Input: Borderless solid dark gray filled box (#1E1E1E) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_task_input"
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundColor="#1E1E1E"
        app:boxCornerRadiusBottomEnd="11dp"
        app:boxCornerRadiusBottomStart="11dp"
        app:boxCornerRadiusTopEnd="11dp"
        app:boxCornerRadiusTopStart="11dp"
        app:boxStrokeColor="@android:color/transparent"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:hintTextColor="@color/zen_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_task_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif"
            android:hint="@string/add_task_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:textColor="@color/white"
            android:textColorHint="#A0A0A0"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Task Completion Time / Duration Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:text="COMPLETION TIME &amp; DURATION"
        android:textColor="#A0A0A0"
        android:textSize="11sp" />

    <!-- Horizontal Scrollable Duration Presets -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_no_limit"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="No Limit"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_30m"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="30 Mins"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_1h"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="1 Hour"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />

            <!-- 3 Hours -->
            <TextView
                android:id="@+id/chip_3h"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="3 Hours"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_today_eod"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Today EOD (6 PM)"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_custom_time"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Custom Time ⏱️"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Timing Summary Card -->
    <LinearLayout
        android:id="@+id/layout_timing_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_task"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Timer"
                android:src="@drawable/ic_schedule"
                app:tint="@color/zen_accent" />

            <TextView
                android:id="@+id/tv_timing_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="Start: 10:00 AM • Due: 1:00 PM (3 hrs)" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:text="🔔 Notification will pull to status bar when due"
            android:textColor="@color/zen_accent"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_task"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/cancel"
            android:textColor="#A0A0A0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_task"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="7dp"
            android:backgroundTint="@color/zen_accent"
            android:fontFamily="sans-serif-bold"
            android:text="Add Task"
            android:textColor="@color/zen_on_accent"
            app:cornerRadius="11dp" />
    </LinearLayout>

</LinearLayout>
