<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Bottom Sheet Drag Handle indicator -->
    <View
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/zen_surface_highlight" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08"
        android:text="NEW TASK"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Task Description Input: Outlined box with rounded corners and neon green focus -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_task_input"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:boxBackgroundColor="#1E1E1E"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/zen_accent"
        app:boxStrokeWidth="1.5dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="@color/zen_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_task_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif"
            android:hint="@string/add_task_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:minHeight="54dp"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:textColor="@color/white"
            android:textColorHint="#A0A0A0"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Task Completion Time / Duration Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.06"
        android:text="COMPLETION TIME &amp; DURATION"
        android:textColor="#A0A0A0"
        android:textSize="12sp" />

    <!-- Horizontal Scrollable Duration Presets -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_no_limit"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="No Limit"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_30m"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="30m"
                android:textColor="#A0A0A0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_1h"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="1h"
                android:textColor="#A0A0A0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_3h"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="3h"
                android:textColor="#A0A0A0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_today_eod"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Today (EOD)"
                android:textColor="#A0A0A0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_custom_time"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Custom Time"
                android:textColor="#A0A0A0"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Timing Summary Preview -->
    <LinearLayout
        android:id="@+id/layout_timing_summary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip_unselected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Time summary"
            android:src="@drawable/ic_schedule"
            app:tint="@color/zen_accent" />

        <TextView
            android:id="@+id/tv_timing_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/zen_accent"
            android:textSize="14sp"
            tools:text="Start: 10:00 AM • Due: 11:00 AM (1h)" />
    </LinearLayout>

    <!-- Task Dialog Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_task"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Cancel"
            android:textColor="#A0A0A0"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_task"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/zen_accent"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Add Task"
            android:textColor="@color/zen_on_accent"
            android:textSize="14sp"
            app:cornerRadius="23dp" />
    </LinearLayout>

</LinearLayout>
