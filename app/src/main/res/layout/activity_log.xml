<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Header Bar with Back Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_13sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_10sdp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_back"
            app:tint="@color/zen_text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_toStartOf="@id/btn_clear_logs"
            android:layout_toEndOf="@id/btn_back"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="ACTIVITY LOG"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_15ssp" />

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="System events and attendance changes"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <!-- Clear Logs Option -->
        <ImageView
            android:id="@+id/btn_clear_logs"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear Activity Logs"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_delete"
            app:tint="@color/zen_text_tertiary" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/zen_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView for Activity Log entries -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_activity_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_20sdp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_empty_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_26sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_46sdp"
                android:layout_height="@dimen/_46sdp"
                android:contentDescription="No logs"
                android:src="@drawable/ic_history"
                app:tint="@color/zen_text_tertiary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="sans-serif-medium"
                android:text="No Activity Logs"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Recent actions, timetable imports, and attendance entries will be recorded here."
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
