<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Header Bar with Back Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="13dp"
        android:paddingTop="13dp"
        android:paddingEnd="13dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/zen_text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="7dp"
            android:layout_toStartOf="@id/btn_clear_logs"
            android:layout_toEndOf="@id/btn_back"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:text="ACTIVITY LOG"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="System events and attendance changes"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Clear Logs Option -->
        <ImageView
            android:id="@+id/btn_clear_logs"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear Activity Logs"
            android:padding="7dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/zen_text_tertiary" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/zen_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView for Activity Log entries -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_activity_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="3dp"
            android:paddingBottom="20dp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_empty_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="26dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="No logs"
                android:src="@drawable/ic_history"
                app:tint="@color/zen_text_tertiary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:fontFamily="sans-serif-medium"
                android:text="No Activity Logs"
                android:textColor="@color/zen_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Recent actions, timetable imports, and attendance entries will be recorded here."
                android:textColor="@color/zen_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
