<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Area -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:text="ZEN"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tv_header_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.15"
                        android:text="ALL NOTES"
                        android:textAllCaps="true"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_item_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="0 notes"
                        android:textColor="@color/zen_accent"
                        android:textSize="11.5sp" />

                    <ImageView
                        android:id="@+id/btn_header_settings"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Settings and Data Management"
                        android:padding="6dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/zen_text_secondary" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:id="@+id/search_bar_container"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/zen_text_secondary" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="@string/search_notes_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/zen_text_primary"
                    android:textColorHint="@color/zen_text_secondary"
                    android:textSize="13.5sp" />

                <ImageView
                    android:id="@+id/btn_clear_search"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/zen_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ViewPager2 for Smooth Flow Window / Swipe Gestures between Notes and Tasks -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
            app:layout_constraintTop_toBottomOf="@id/header_layout" />

        <!-- Modern Floating Navigation Bar with Real-time Sliding Indicator & Material Symbols -->
        <FrameLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_floating_bottom_nav"
            android:elevation="6dp"
            android:padding="4dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Sliding Indicator Pill that animates seamlessly between tabs -->
            <View
                android:id="@+id/nav_sliding_indicator"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_tab_active" />

            <!-- Tab Items Container -->
            <LinearLayout
                android:id="@+id/nav_tabs_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Tab 1: NOTES -->
                <LinearLayout
                    android:id="@+id/btn_nav_notes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_nav_notes_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Notes"
                        android:src="@drawable/ic_notes"
                        app:tint="@color/zen_on_accent" />

                    <TextView
                        android:id="@+id/tv_nav_notes_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.08"
                        android:text="NOTES"
                        android:textColor="@color/zen_on_accent"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Tab 2: TASKS -->
                <LinearLayout
                    android:id="@+id/btn_nav_tasks"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_nav_tasks_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Tasks"
                        android:src="@drawable/ic_tasks"
                        app:tint="@color/zen_text_secondary" />

                    <TextView
                        android:id="@+id/tv_nav_tasks_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="TASKS"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Tab 3: CLASSES -->
                <LinearLayout
                    android:id="@+id/btn_nav_attendance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_nav_attendance_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Classes"
                        android:src="@drawable/ic_school"
                        app:tint="@color/zen_text_secondary" />

                    <TextView
                        android:id="@+id/tv_nav_attendance_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="CLASSES"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Action Button (Squircle shape) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="84dp"
        android:contentDescription="Add Item"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/zen_accent"
        app:elevation="8dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ZEN.Rounded2xl"
        app:tint="@color/zen_on_accent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
