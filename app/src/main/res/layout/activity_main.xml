<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true">

    <!-- Top Header Area -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1"
                    android:text="ZEN"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="ALL NOTES"
                    android:textAllCaps="true"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="0 notes"
                    android:textColor="@color/zen_accent"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/btn_header_settings"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="7dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings and Data Management"
                    android:padding="5dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/zen_text_secondary" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/zen_text_secondary" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="@string/search_notes_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/zen_text_primary"
                android:textColorHint="@color/zen_text_secondary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/zen_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ViewPager2 for Tabbed Swiping: Notes (0), Tasks (1), Attendance (2) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
        app:layout_constraintTop_toBottomOf="@id/header_layout" />

    <!-- Floating Pill Navigation Bar -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_bottom_nav"
        android:elevation="6dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/nav_sliding_indicator"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_tab_active" />

        <LinearLayout
            android:id="@+id/nav_tabs_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Notes Tab -->
            <LinearLayout
                android:id="@+id/btn_nav_notes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_nav_notes_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Notes"
                    android:src="@drawable/ic_notes"
                    app:tint="@color/zen_accent" />

                <TextView
                    android:id="@+id/tv_nav_notes_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:text="NOTES"
                    android:textColor="@color/zen_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tasks Tab -->
            <LinearLayout
                android:id="@+id/btn_nav_tasks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_nav_tasks_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Tasks"
                    android:src="@drawable/ic_tasks"
                    app:tint="@color/zen_text_secondary" />

                <TextView
                    android:id="@+id/tv_nav_tasks_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="TASKS"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Classes / Attendance Tab -->
            <LinearLayout
                android:id="@+id/btn_nav_attendance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_nav_attendance_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Classes"
                    android:src="@drawable/ic_school"
                    app:tint="@color/zen_text_secondary" />

                <TextView
                    android:id="@+id/tv_nav_attendance_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="CLASSES"
                    android:textColor="@color/zen_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Action Button: Constrained strictly above bottom nav -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="84dp"
        android:contentDescription="Add Item"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/zen_accent"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ZEN.Rounded2xl"
        app:tint="@color/zen_on_accent" />

    <!-- Auxiliary views for optional Fragment container compatibility -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
