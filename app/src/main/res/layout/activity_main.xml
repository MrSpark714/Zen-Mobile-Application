<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true">

    <!-- Top Header Area (Matches Zen Dark Minimalist Dashboard Header) -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Left: ZEN Brand + Offline Cloud Icon + LOCAL Pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="ZEN"
                    android:textColor="@color/zen_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_header_offline"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:alpha="0.8"
                    android:contentDescription="Offline storage active"
                    android:src="@drawable/ic_cloud_off"
                    app:tint="@color/zen_text_secondary" />

                <!-- LOCAL Status Pill -->
                <LinearLayout
                    android:id="@+id/pill_local_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_surface_high"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="4dp">

                    <View
                        android:id="@+id/dot_local_pulse"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_lime" />

                    <TextView
                        android:id="@+id/tv_header_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="LOCAL"
                        android:textAllCaps="true"
                        android:textColor="@color/zen_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: Count Badge (Notes/Tasks) + Theme Toggle + Settings Gear + Profile Circle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="0 notes"
                    android:textColor="@color/zen_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btn_header_theme_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Switch to Dark theme"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dark_mode"
                    app:tint="@color/zen_text_secondary" />

                <ImageButton
                    android:id="@+id/btn_header_settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings and Data Management"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/zen_text_secondary" />

                <FrameLayout
                    android:id="@+id/btn_header_profile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Academic Profile"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_header_profile_initial"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_primary"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/zen_on_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_header_profile_photo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Profile Photo"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Search Bar (Visible on Notes and Tasks tabs) -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/zen_text_tertiary" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/inter"
                android:gravity="center_vertical"
                android:hint="@string/search_notes_hint"
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/zen_text_primary"
                android:textColorHint="@color/zen_text_tertiary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/zen_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ViewPager2 for Tabbed Swiping: Notes (0), Tasks (1), Classes Dashboard (2) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
        app:layout_constraintTop_toBottomOf="@id/header_layout" />

    <!-- Floating Pill Navigation Bar (UNCHANGED) -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_bottom_nav"
        android:elevation="6dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/nav_tabs_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Notes Tab -->
            <FrameLayout
                android:id="@+id/btn_nav_notes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/pill_nav_notes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/bg_nav_tab_active" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_nav_notes_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Notes"
                        android:src="@drawable/ic_notes"
                        app:tint="@color/zen_nav_inactive" />

                    <TextView
                        android:id="@+id/tv_nav_notes_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="NOTES"
                        android:textColor="@color/zen_nav_inactive"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tasks Tab -->
            <FrameLayout
                android:id="@+id/btn_nav_tasks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/pill_nav_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/bg_nav_tab_active" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_nav_tasks_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Tasks"
                        android:src="@drawable/ic_tasks"
                        app:tint="@color/zen_nav_inactive" />

                    <TextView
                        android:id="@+id/tv_nav_tasks_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="TASKS"
                        android:textColor="@color/zen_nav_inactive"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Classes / Attendance Tab -->
            <FrameLayout
                android:id="@+id/btn_nav_attendance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/pill_nav_attendance"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_tab_active" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_nav_attendance_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Classes"
                        android:src="@drawable/ic_school"
                        app:tint="@color/zen_on_accent_container" />

                    <TextView
                        android:id="@+id/tv_nav_attendance_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="CLASSES"
                        android:textColor="@color/zen_on_accent_container"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Action Button: Constrained strictly above bottom nav -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="84dp"
        android:contentDescription="Add Item"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/zen_fab_bg"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ZEN.Rounded2xl"
        app:tint="@color/zen_on_fab" />

</androidx.constraintlayout.widget.ConstraintLayout>
