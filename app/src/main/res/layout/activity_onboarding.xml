<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true">

    <!-- Centered Brand, Title and Description Area -->
    <LinearLayout
        android:id="@+id/onboarding_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Logo Frame -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardBackgroundColor="@color/zen_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/zen_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/iv_onboarding_logo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/zen_logo_f" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Welcome Heading -->
        <TextView
            android:id="@+id/tv_onboarding_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/onboarding_welcome_title"
            android:textColor="@color/zen_text_primary"
            android:textSize="26sp" />

        <!-- Explanatory Context Paragraph -->
        <TextView
            android:id="@+id/tv_onboarding_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/onboarding_welcome_desc"
            android:textColor="@color/zen_text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Bottom Actions Container: Stacked Primary & Secondary Buttons -->
    <LinearLayout
        android:id="@+id/bottom_actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primary Action: Import Data -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_import"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:tag="btn_onboarding_import"
            android:text="@string/onboarding_btn_import"
            android:textColor="@color/zen_on_accent"
            android:textSize="15sp"
            app:backgroundTint="@color/zen_accent"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:iconTint="@color/zen_on_accent"
            app:strokeWidth="0dp" />

        <!-- Secondary Action: Start Fresh -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_fresh"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:tag="btn_onboarding_fresh"
            android:text="@string/onboarding_btn_fresh"
            android:textColor="@color/zen_text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/zen_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/zen_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
