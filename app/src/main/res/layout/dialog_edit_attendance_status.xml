<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_16sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_23sdp">

    <!-- Top Drag Handle indicator -->
    <View
        android:layout_width="@dimen/_33sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="@color/zen_border" />

    <!-- Header info -->
    <TextView
        android:id="@+id/tv_dialog_status_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.06"
        android:text="EDIT ATTENDANCE STATUS"
        android:textColor="@color/zen_text_primary"
        android:textSize="@dimen/_14ssp" />

    <TextView
        android:id="@+id/tv_dialog_status_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:fontFamily="sans-serif"
        android:text="Select status for past class session"
        android:textColor="@color/zen_text_secondary"
        android:textSize="@dimen/_11ssp" />

    <!-- Option: PRESENT -->
    <LinearLayout
        android:id="@+id/btn_option_present"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/bg_status_present"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_11sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_11sdp">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_check"
            app:tint="@color/status_present" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Present"
                android:textColor="@color/status_present"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="sans-serif"
                android:text="Attended class session"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_check_present"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/status_present" />
    </LinearLayout>

    <!-- Option: ABSENT -->
    <LinearLayout
        android:id="@+id/btn_option_absent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/bg_status_absent"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_11sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_11sdp">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_close"
            app:tint="@color/status_absent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Absent"
                android:textColor="@color/status_absent"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="sans-serif"
                android:text="Missed class session"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_check_absent"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/status_absent" />
    </LinearLayout>

    <!-- Option: HOLIDAY -->
    <LinearLayout
        android:id="@+id/btn_option_holiday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_status_holiday"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_11sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_11sdp">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/status_holiday" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Holiday / Cancelled"
                android:textColor="@color/status_holiday"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="sans-serif"
                android:text="College holiday or class cancelled"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_check_holiday"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/status_holiday" />
    </LinearLayout>

    <!-- Cancel button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_status_dialog"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:text="Cancel"
        android:textColor="@color/zen_text_secondary"
        android:textSize="@dimen/_12ssp" />

</LinearLayout>
