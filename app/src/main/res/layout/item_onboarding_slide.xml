<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/slide_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <!-- Illustration / Icon Container with Radiant Glow -->
        <FrameLayout
            android:id="@+id/slide_icon_container"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/bg_onboarding_icon_glow"
            app:layout_constraintBottom_toTopOf="@+id/tv_slide_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.42"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:id="@+id/iv_slide_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_onboarding_workspace" />
        </FrameLayout>

        <!-- Bold Slide Title (~22sp) -->
        <TextView
            android:id="@+id/tv_slide_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tv_slide_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/slide_icon_container"
            tools:text="Unified Student Workspace" />

        <!-- Concise Description (~14sp, muted grey) -->
        <TextView
            android:id="@+id/tv_slide_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/zen_text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/layout_final_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_slide_title"
            tools:text="Capture thoughts with markdown notes and stay on top of daily coursework with precise, distraction-free task scheduling." />

        <!-- Slide 3 Migration & Setup Action Buttons (Only visible on final slide) -->
        <LinearLayout
            android:id="@+id/layout_final_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_slide_description"
            tools:visibility="visible">

            <!-- "Start Fresh" (Solid neon green primary button) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_fresh"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:text="@string/onboarding_btn_start_fresh"
                android:textColor="@color/zen_on_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/zen_accent"
                app:cornerRadius="16dp"
                app:elevation="4dp" />

            <!-- "Import Legacy Backup" (Outlined / secondary button) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_backup"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:icon="@drawable/ic_backup"
                android:minHeight="54dp"
                android:text="@string/onboarding_btn_import_backup"
                android:textColor="@color/zen_text_primary"
                android:textSize="14sp"
                app:iconGravity="textStart"
                app:cornerRadius="16dp"
                app:iconTint="@color/zen_accent"
                app:strokeColor="@color/zen_border"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
