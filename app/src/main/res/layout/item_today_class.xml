<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_today_class"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_16sdp"
    android:layout_marginTop="@dimen/_5sdp"
    android:layout_marginEnd="@dimen/_16sdp"
    android:layout_marginBottom="@dimen/_7sdp"
    android:backgroundTint="@color/zen_surface"
    app:cardCornerRadius="@dimen/_13sdp"
    app:cardElevation="0dp"
    app:strokeColor="@color/zen_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_13sdp">

        <!-- Top Header: Subject Name & Class Type Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_subject_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/tv_class_type"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_14ssp"
                tools:text="Data Structures &amp; Algorithms" />

            <TextView
                android:id="@+id/tv_class_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_type_theory"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:paddingStart="@dimen/_7sdp"
                android:paddingTop="@dimen/_2sdp"
                android:paddingEnd="@dimen/_7sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:text="THEORY"
                android:textColor="@color/type_theory_text"
                android:textSize="@dimen/_9ssp" />
        </RelativeLayout>

        <!-- Time & Room Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:contentDescription="Time"
                android:src="@drawable/ic_schedule"
                app:tint="@color/zen_accent" />

            <TextView
                android:id="@+id/tv_class_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:fontFamily="sans-serif"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_11ssp"
                tools:text="09:00 AM - 10:30 AM" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:text="•"
                android:textColor="@color/zen_text_tertiary" />

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:contentDescription="Room"
                android:src="@drawable/ic_room"
                app:tint="@color/zen_text_secondary" />

            <TextView
                android:id="@+id/tv_room_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_3sdp"
                android:fontFamily="sans-serif"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_11ssp"
                tools:text="Room 302" />

            <TextView
                android:id="@+id/tv_credit_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:fontFamily="sans-serif"
                android:textColor="@color/zen_text_tertiary"
                android:textSize="@dimen/_10ssp"
                tools:text="(3 Cr)" />
        </LinearLayout>

        <!-- Current Recorded Status Banner (Visible when marked) -->
        <LinearLayout
            android:id="@+id/layout_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_8sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:src="@drawable/ic_check"
                app:tint="@color/zen_accent" />

            <TextView
                android:id="@+id/tv_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:textColor="@color/zen_accent"
                android:textSize="@dimen/_10ssp"
                tools:text="Marked: Present" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@color/zen_divider" />

        <!-- Attendance Action Chips (Present, Absent, Holiday) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_32sdp"
            android:orientation="horizontal">

            <!-- Present Button -->
            <TextView
                android:id="@+id/btn_status_present"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_status_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:minHeight="@dimen/_40sdp"
                android:text="Present"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <!-- Absent Button -->
            <TextView
                android:id="@+id/btn_status_absent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_status_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:minHeight="@dimen/_40sdp"
                android:text="Absent"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <!-- Holiday Button -->
            <TextView
                android:id="@+id/btn_status_holiday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_status_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:minHeight="@dimen/_40sdp"
                android:text="Holiday"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
