<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Header Bar with Back Button and Delete Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_13sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_10sdp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_back"
            app:tint="@color/zen_text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_toStartOf="@id/layout_header_end_actions"
            android:layout_toEndOf="@id/btn_back"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="DETAILED HISTORY"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_15ssp"
                tools:text="OPERATING SYSTEMS" />

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Tap status tag to edit past attendance"
                android:textColor="@color/zen_accent"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <!-- End Actions: Percentage Badge + Delete Icon Button (Trash Can) -->
        <LinearLayout
            android:id="@+id/layout_header_end_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_log_badge_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingEnd="@dimen/_8sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:textColor="@color/zen_accent"
                android:textSize="@dimen/_11ssp"
                tools:text="85.7%" />

            <!-- Small Delete Icon Button (Trash Can) -->
            <ImageView
                android:id="@+id/btn_delete_subject_history"
                android:layout_width="@dimen/_33sdp"
                android:layout_height="@dimen/_33sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Subject History"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_absent" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/zen_border" />

    <!-- Summary Stats Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_stats_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:layout_marginEnd="@dimen/_13sdp"
        android:backgroundTint="@color/zen_surface"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/zen_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_13sdp">

            <TextView
                android:id="@+id/tv_log_subject_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_15ssp"
                tools:text="Operating Systems" />

            <TextView
                android:id="@+id/tv_log_breakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="sans-serif"
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_11ssp"
                tools:text="12 Present • 2 Absent • 1 Holiday" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- History List Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_7sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06"
            android:text="SESSION HISTORY"
            android:textColor="@color/zen_text_secondary"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/tv_total_records_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/zen_text_tertiary"
            android:textSize="@dimen/_10ssp"
            tools:text="15 Records" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- History RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_log_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_20sdp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_26sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_46sdp"
                android:layout_height="@dimen/_46sdp"
                android:contentDescription="Empty Log"
                android:src="@drawable/ic_history"
                app:tint="@color/zen_text_tertiary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="sans-serif-medium"
                android:text="No Attendance Records"
                android:textColor="@color/zen_text_primary"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Mark attendance from the Today tab to build this subject's history ledger."
                android:textColor="@color/zen_text_secondary"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
